from typing import List
import math
def f(numbers: List[int]) -> List[int]:
    # Filter numbers not divisible by 3 or 5
    filtered_numbers = [num for num in numbers if num % 3 != 0 and num % 5 != 0]

    # Select every second element starting from the first
    selected_numbers = [filtered_numbers[i] for i in range(0, len(filtered_numbers), 2)]

    # Transform numbers
    transformed_numbers = [num ** 2 if num > 10 else math.log(num) for num in selected_numbers]

    return transformed_numbers
