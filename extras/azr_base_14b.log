[37m┃ [0m[36mfrom math import prod                                                       [0m[37m ┃[0m
[37m┃ [0m[36mdef f(numbers_list: list) -> int:                                           [0m[37m ┃[0m
[37m┃ [0m[36m    differences_product = 1                                                 [0m[37m ┃[0m
[37m┃ [0m[36m    for sublist in numbers_list:                                            [0m[37m ┃[0m
[37m┃ [0m[36m        min_val = min(sublist)                                              [0m[37m ┃[0m
[37m┃ [0m[36m        max_val = max(sublist)                                              [0m[37m ┃[0m
[37m┃ [0m[36m        differences_product *= max_val - min_val                            [0m[37m ┃[0m
