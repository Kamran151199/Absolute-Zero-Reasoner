[37m┃ [0m[36m    # Step 2: Square the numbers that are greater than 10                   [0m[37m ┃[0m
[37m┃ [0m[36m    squared_numbers = [num ** 2 for num in filtered_numbers if num > 10]    [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    # Step 3: Multiply the remaining numbers by 3                           [0m[37m ┃[0m
[37m┃ [0m[36m    multiplied_numbers = [num * 3 for num in filtered_numbers if num <= 10] [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    # Step 4: Concatenate the two lists                                     [0m[37m ┃[0m
[37m┃ [0m[36m    combined_numbers = squared_numbers + multiplied_numbers                 [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    # Step 5: Sort the combined list in ascending order                     [0m[37m ┃[0m
[37m┃ [0m[36m    sorted_numbers = sorted(combined_numbers)                               [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    # Step 6: Compute the sum of the sorted numbers                         [0m[37m ┃[0m
[37m┃ [0m[36m    result = sum(sorted_numbers)                                            [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
