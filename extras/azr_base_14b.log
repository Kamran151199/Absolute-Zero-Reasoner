[37m┃ [0m[36m    # Initialize a dictionary to store the count of students per subject    [0m[37m ┃[0m
[37m┃ [0m[36m    subject_counts = {}                                                     [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
