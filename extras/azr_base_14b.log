[37m┃ [0m[36m    # Step 1: Filter out numbers that are at even indices and are less than or equal to 20[0m[37m ┃[0m
[37m┃ [0m[36m    filtered_numbers = [num for index, num in enumerate(numbers) if index % 2 == 0 and num <= 20][0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    # Step 2: Transform the filtered numbers by squaring them if they are less than 10, [0m[37m ┃[0m
[37m┃ [0m[36m    # otherwise, subtract 10 from them                                      [0m[37m ┃[0m
[37m┃ [0m[36m    transformed_numbers = [num**2 if num < 10 else num - 10 for num in filtered_numbers][0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    # Step 3: Calculate the sum of the transformed numbers                  [0m[37m ┃[0m
