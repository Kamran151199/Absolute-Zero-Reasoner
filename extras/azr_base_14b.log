[37m┃ [0m[36m    # Step 2: Calculate the factorial of each filtered number               [0m[37m ┃[0m
[37m┃ [0m[36m    factorial_numbers = [math.factorial(num) for num in filtered_numbers]   [0m[37m ┃[0m
