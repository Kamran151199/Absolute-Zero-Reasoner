[37m┃ [0m[36m    # Step 2: Square each number                                            [0m[37m ┃[0m
[37m┃ [0m[36m    squared_numbers = [num ** 2 for num in multiples_of_4]                  [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    # Step 3: Filter out squared numbers that are less than 100             [0m[37m ┃[0m
[37m┃ [0m[36m    filtered_squares = [sq for sq in squared_numbers if sq >= 100]          [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    # Step 4: Sort the remaining squares in ascending order                 [0m[37m ┃[0m
[37m┃ [0m[36m    sorted_squares = sorted(filtered_squares)                               [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    # Step 5: Sum the squares to produce the result                         [0m[37m ┃[0m
[37m┃ [0m[36m    result = sum(sorted_squares)                                            [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    return result                                                           [0m[37m ┃[0m
