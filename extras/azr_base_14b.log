[37m┃ [0m[36m    # Step 1: Filter out numbers that are multiples of 3 or 7               [0m[37m ┃[0m
[37m┃ [0m[36m    filtered_numbers = [num for num in numbers if num % 3 != 0 and num % 7 != 0][0m[37m ┃[0m
