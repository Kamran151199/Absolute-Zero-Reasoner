[37m┃ [0m[36m    for i in range(1, len(filtered_sorted), 3):                             [0m[37m ┃[0m
[37m┃ [0m[36m        if i < len(filtered_sorted):                                        [0m[37m ┃[0m
[37m┃ [0m[36m            product_every_third *= filtered_sorted[i]                       [0m[37m ┃[0m
[37m┃ [0m[36m    return sum_every_second + product_every_third                           [0m[37m ┃[0m
