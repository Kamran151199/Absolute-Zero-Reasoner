[37m┃ [0m[36mdef is_prime(n):                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    if n <= 1:                                                              [0m[37m ┃[0m
[37m┃ [0m[36m        return False                                                        [0m[37m ┃[0m
[37m┃ [0m[36m    if n <= 3:                                                              [0m[37m ┃[0m
[37m┃ [0m[36m        return True                                                         [0m[37m ┃[0m
[37m┃ [0m[36m    if n % 2 == 0 or n % 3 == 0:                                            [0m[37m ┃[0m
[37m┃ [0m[36m        return False                                                        [0m[37m ┃[0m
[37m┃ [0m[36m    i = 5                                                                   [0m[37m ┃[0m
[37m┃ [0m[36m    while i * i <= n:                                                       [0m[37m ┃[0m
[37m┃ [0m[36m        if n % i == 0 or n % (i + 2) == 0:                                  [0m[37m ┃[0m
[37m┃ [0m[36m            return False                                                    [0m[37m ┃[0m
[37m┃ [0m[36m        i += 6                                                              [0m[37m ┃[0m
[37m┃ [0m[36m    return True                                                             [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36mdef f(numbers):                                                             [0m[37m ┃[0m
[37m┃ [0m[36m    primes = [n for i, n in enumerate(numbers) if is_prime(n)]              [0m[37m ┃[0m
[37m┃ [0m[36m    incremented_primes = [prime + i for i, prime in enumerate(primes)]      [0m[37m ┃[0m
