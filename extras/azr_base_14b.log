[37m┃ [0m[36m    for ascii_val in ascii_values:                                          [0m[37m ┃[0m
[37m┃ [0m[36m        group_key = ascii_val % 6                                           [0m[37m ┃[0m
[37m┃ [0m[36m        if group_key not in groups:                                         [0m[37m ┃[0m
[37m┃ [0m[36m            groups[group_key] = []                                          [0m[37m ┃[0m
[37m┃ [0m[36m        groups[group_key].append(ascii_val)                                 [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    group_sizes = [len(group) for group in groups.values()]                 [0m[37m ┃[0m
[37m┃ [0m[36m    product_of_sizes = 1                                                    [0m[37m ┃[0m
[37m┃ [0m[36m    for size in group_sizes:                                                [0m[37m ┃[0m
[37m┃ [0m[36m        product_of_sizes *= size                                            [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    calculated_value = int(threshold ** (1 / product_of_sizes))             [0m[37m ┃[0m
