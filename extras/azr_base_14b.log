[37m┃ [0m[36m    filtered_books = [book for book in book_list if len(book['authors']) >= 2][0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    # Create a dictionary to count the number of books written by each author[0m[37m ┃[0m
[37m┃ [0m[36m    author_count = {}                                                       [0m[37m ┃[0m
[37m┃ [0m[36m    for book in filtered_books:                                             [0m[37m ┃[0m
[37m┃ [0m[36m        for author in book['authors']:                                      [0m[37m ┃[0m
[37m┃ [0m[36m            if author not in author_count:                                  [0m[37m ┃[0m
[37m┃ [0m[36m                author_count[author] = 0                                    [0m[37m ┃[0m
[37m┃ [0m[36m            author_count[author] += 1                                       [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    # Sort the authors by the number of books they've written in descending order[0m[37m ┃[0m
[37m┃ [0m[36m    sorted_authors = sorted(author_count.items(), key=lambda x: x[1], reverse=True)[0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    # Return a list of authors and their book counts                        [0m[37m ┃[0m
[37m┃ [0m[36m    return [(author, count) for author, count in sorted_authors]            [0m[37m ┃[0m
