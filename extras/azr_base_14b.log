def f(canvas_size: tuple, start_point: tuple, color: str, pattern: str):
    canvas = [[0] * canvas_size[0] for _ in range(canvas_size[1])]
    x, y = start_point
    absolute_color = abs(ord(color[0]) - 65) % 3
    pattern_numbers = [int(s) for s in pattern.split()]
    for n in pattern_numbers:
        x += n if len(canvas[0]) > x + n > abs(n+x) else -n if len(canvas[0]) > abs(n-x) > x - n else 0
        y += n if len(canvas) > y + n > abs(n+y) else -n if len(canvas) > abs(n-y) > y - n else 0
        canvas[y][x] = absolute_color + 1
    total_cells_inspected = sum([sum(x) for x in canvas])
    sequence_of_moves = pattern_numbers[::absolute_color]
    return (total_cells_inspected, sum(sequence_of_moves))
```

