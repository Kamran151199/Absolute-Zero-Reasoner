[37m┃ [0m[36mdef f(tuples_list: list[tuple]):                                            [0m[37m ┃[0m
[37m┃ [0m[36m    transformed_list = []                                                   [0m[37m ┃[0m
[37m┃ [0m[36m    for tpl in tuples_list:                                                 [0m[37m ┃[0m
[37m┃ [0m[36m        sum_of_elements = sum(tpl)                                          [0m[37m ┃[0m
[37m┃ [0m[36m        if any(x % 2 == 0 for x in tpl):                                    [0m[37m ┃[0m
[37m┃ [0m[36m            transformed_value = sum_of_elements * 3                         [0m[37m ┃[0m
[37m┃ [0m[36m        else:                                                               [0m[37m ┃[0m
[37m┃ [0m[36m            transformed_value = sum_of_elements * 2                         [0m[37m ┃[0m
[37m┃ [0m[36m        transformed_list.append((transformed_value, tpl))                   [0m[37m ┃[0m
[37m┃ [0m[36m    sorted_list = sorted(transformed_list, key=lambda item: item[0])        [0m[37m ┃[0m
[37m┃ [0m[36m    output = [tuple(item[1]) for item in sorted_list]                       [0m[37m ┃[0m
[37m┃ [0m[36m    return output                                                           [0m[37m ┃[0m
