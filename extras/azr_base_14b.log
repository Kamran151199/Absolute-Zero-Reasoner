[37m┃ [0m[36m    from a list of lists of integers.                                       [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    Parameters:                                                             [0m[37m ┃[0m
[37m┃ [0m[36m    lists (list of list of int): The input list of lists.                   [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    Returns:                                                                [0m[37m ┃[0m
[37m┃ [0m[36m    tuple: A tuple containing a list of sublists with the maximum sum       [0m[37m ┃[0m
[37m┃ [0m[36m    and an integer representing the length of those sublists.               [0m[37m ┃[0m
[37m┃ [0m[36m    """                                                                     [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    max_sum = float('-inf')  # Initialize max sum to negative infinity      [0m[37m ┃[0m
[37m┃ [0m[36m    sublists = []  # List to hold sublists with max sum                     [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    # Iterate through each sublist                                          [0m[37m ┃[0m
[37m┃ [0m[36m    for sublist in lists:                                                   [0m[37m ┃[0m
[37m┃ [0m[36m        if sum(sublist) > max_sum:                                          [0m[37m ┃[0m
[37m┃ [0m[36m            max_sum = sum(sublist)  # Update max sum                        [0m[37m ┃[0m
[37m┃ [0m[36m            sublists = [sublist]    # Reset sublists list                   [0m[37m ┃[0m
[37m┃ [0m[36m        elif sum(sublist) == max_sum:                                       [0m[37m ┃[0m
[37m┃ [0m[36m            sublists.append(sublist)  # Append sublist to sublists list     [0m[37m ┃[0m
