[37m┃ [0m[36mfrom typing import List, Tuple                                              [0m[37m ┃[0m
[37m┃ [0m[36mdef f(l: List[List[int]]) -> Tuple[List[int], int]:                         [0m[37m ┃[0m
[37m┃ [0m[36m    max_sum = -float('inf')                                                 [0m[37m ┃[0m
[37m┃ [0m[36m    target_length = -1                                                      [0m[37m ┃[0m
[37m┃ [0m[36m    for sublist in l:                                                       [0m[37m ┃[0m
[37m┃ [0m[36m        if isinstance(sublist, List):                                       [0m[37m ┃[0m
[37m┃ [0m[36m            sub_sum = sum(sublist)                                          [0m[37m ┃[0m
[37m┃ [0m[36m            if sub_sum > max_sum:                                           [0m[37m ┃[0m
[37m┃ [0m[36m                max_sum = sub_sum                                           [0m[37m ┃[0m
[37m┃ [0m[36m                target_length = len(sublist)                                [0m[37m ┃[0m
[37m┃ [0m[36m    result_sublist = [sublist for sublist in l if len(sublist) == target_length and sum(sublist) == max_sum][0m[37m ┃[0m
[37m┃ [0m[36m    return (result_sublist, target_length)                                  [0m[37m ┃[0m
