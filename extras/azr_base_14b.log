[37m┃ [0m[36m    # Step 2: For numbers less than or equal to the average, square them; for those greater, subtract 1[0m[37m ┃[0m
[37m┃ [0m[36m    transformed_numbers = [num**2 if num < average else num - 1 for num in filtered_numbers][0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    # Step 3: Sort the transformed numbers in ascending order               [0m[37m ┃[0m
[37m┃ [0m[36m    sorted_numbers = sorted(transformed_numbers)                            [0m[37m ┃[0m
