[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    # Filter out numbers greater than the threshold                         [0m[37m ┃[0m
[37m┃ [0m[36m    filtered_numbers = [num for num in numbers if num <= threshold]         [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
