[37m┃ [0m[36m    max_length = max(len(s) for s in sublists)  # Determine max length of sublists[0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    return sublists, max_length  # Return the sublists and max length       [0m[37m ┃[0m
