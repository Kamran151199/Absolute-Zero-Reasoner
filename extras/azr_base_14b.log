[37m┃ [0m[36m            rotated_letter = chr((ascii_num - 97 + rotation) % 26 + 97)     [0m[37m ┃[0m
[37m┃ [0m[36m        else:                                                               [0m[37m ┃[0m
[37m┃ [0m[36m            rotated_letter = letter                                         [0m[37m ┃[0m
[37m┃ [0m[36m        rotated_text += rotated_letter                                      [0m[37m ┃[0m
[37m┃ [0m[36m    return rotated_text                                                     [0m[37m ┃[0m
