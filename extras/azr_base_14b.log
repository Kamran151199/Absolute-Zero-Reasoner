[37m┃ [0m[36mdef f(students: list) -> dict:                                              [0m[37m ┃[0m
[37m┃ [0m[36m    # Filter out students under 18                                          [0m[37m ┃[0m
[37m┃ [0m[36m    mature_students = [student for student in students if student['age'] >= 18][0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    # Calculate the average age for each subject                            [0m[37m ┃[0m
[37m┃ [0m[36m    average_ages = {}                                                       [0m[37m ┃[0m
[37m┃ [0m[36m    for student in mature_students:                                         [0m[37m ┃[0m
[37m┃ [0m[36m        for subject in student['subjects']:                                 [0m[37m ┃[0m
[37m┃ [0m[36m            if subject not in average_ages:                                 [0m[37m ┃[0m
[37m┃ [0m[36m                average_ages[subject] = {'total_age': 0, 'count': 0}        [0m[37m ┃[0m
[37m┃ [0m[36m            average_ages[subject]['total_age'] += student['age']            [0m[37m ┃[0m
[37m┃ [0m[36m            average_ages[subject]['count'] += 1                             [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    # Calculate the average for each subject                                [0m[37m ┃[0m
[37m┃ [0m[36m    for subject in average_ages:                                            [0m[37m ┃[0m
[37m┃ [0m[36m        average_ages[subject] = average_ages[subject]['total_age'] / average_ages[subject]['count'][0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    # Return the dictionary of average ages                                 [0m[37m ┃[0m
[37m┃ [0m[36m    return average_ages                                                     [0m[37m ┃[0m
