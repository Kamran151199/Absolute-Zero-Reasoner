[37m┃ [0m[36m        value = len(processed_string) * n                                   [0m[37m ┃[0m
[37m┃ [0m[36m        if n % 2 != 0:                                                      [0m[37m ┃[0m
[37m┃ [0m[36m            value -= 1                                                      [0m[37m ┃[0m
[37m┃ [0m[36m        max_value = max(max_value, value)                                   [0m[37m ┃[0m
