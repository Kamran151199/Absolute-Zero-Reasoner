[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36mdef f(numbers: List[int]) -> List[int]:                                     [0m[37m ┃[0m
[37m┃ [0m[36m    # Step 1: Find all combinations of 3 numbers from the input list        [0m[37m ┃[0m
[37m┃ [0m[36m    combinations_of_three = list(combinations(numbers, 3))                  [0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    # Step 2: Count occurrences of each sum of combinations                 [0m[37m ┃[0m
[37m┃ [0m[36m    sum_counts = {}                                                         [0m[37m ┃[0m
[37m┃ [0m[36m    for combo in combinations_of_three:                                     [0m[37m ┃[0m
[37m┃ [0m[36m        combo_sum = sum(combo)                                              [0m[37m ┃[0m
[37m┃ [0m[36m        if combo_sum in sum_counts:                                         [0m[37m ┃[0m
[37m┃ [0m[36m            sum_counts[combo_sum] += 1                                      [0m[37m ┃[0m
[37m┃ [0m[36m        else:                                                               [0m[37m ┃[0m
