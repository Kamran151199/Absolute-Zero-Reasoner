[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
[37m┃ [0m[36m    # Step 4: Calculate the difference between each pair of consecutive numbers in the sorted list[0m[37m ┃[0m
[37m┃ [0m[36m    differences = [sorted_factorials[i] - sorted_factorials[i-1] for i in range(1, len(sorted_factorials))][0m[37m ┃[0m
[37m┃ [0m[36m                                                                            [0m[37m ┃[0m
